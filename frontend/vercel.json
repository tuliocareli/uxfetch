{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/_next/:match*",
      "destination": "https://app.uxfetch.com.br/_next/:match*"
    },
    {
      "source": "/blog/:match*",
      "destination": "https://app.uxfetch.com.br/blog/:match*"
    },
    {
      "source": "/blog",
      "destination": "https://app.uxfetch.com.br/blog"
    },
    {
      "source": "/post.html",
      "destination": "https://app.uxfetch.com.br/post.html"
    }
  ],
  "redirects": [
    {
      "source": "/artigo/o-que-eu-aprendi-enviando-563-vagas-de-design-em-30-dias",
      "destination": "/blog/analise-563-vagas-design",
      "permanent": true
    },
    {
      "source": "/artigo/onde-encontrar-vagas-de-product-design-fora-da-gupy-e-do-linkedin",
      "destination": "/blog/vagas-product-design-fora-linkedin",
      "permanent": true
    },
    {
      "source": "/artigo/o-oceano-azul-como-encontrar-as-melhores-vagas-de-design-fora-do-linkedin",
      "destination": "/blog/melhores-vagas-design-fora-linkedin",
      "permanent": true
    },
    {
      "source": "/artigo/como-achar-vagas-gringas-de-ux-design-e-filtrar-o-ruido",
      "destination": "/blog/vagas-gringas-ux-design",
      "permanent": true
    },
    {
      "source": "/artigo/o-que-as-empresas-realmente-exigem-de-um-product-designer-analise-de-mercado",
      "destination": "/blog/requisitos-habilidades-product-designer",
      "permanent": true
    },
    {
      "source": "/artigo/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ]
}
